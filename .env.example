# Backend
PORT=3000

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_VARIANT_MODEL=gemini-3.5-flash-lite
GEMINI_NUMBER_MODEL=gemini-3.5-flash-lite
GEMINI_NUMBER_FALLBACK_MODEL=gemini-3.5-flash
# Set false to restore the previous recognition and comparison pipeline.
SCAN_OPTIMIZED=true
# Fast number reading; set low to restore the previous reasoning level.
SCAN_NUMBER_REASONING=minimal
# Provisional threshold, to calibrate on labeled photographs.
SCAN_MATCH_THRESHOLD=0.95
# Shared Cardmarket catalog cache (memory + disk); refresh after one hour.
CARDMARKET_CACHE_ENABLED=true
CARDMARKET_CACHE_TTL_MS=3600000
DATABASE_PATH=
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api

# Authentication: configure SMTP to deliver registration codes.
AUTH_VERIFICATION_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HakiScan <no-reply@hakiscan.local>
